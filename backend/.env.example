SUPABASE_URL=your-supabase-url
SUPABASE_KEY=your-supabase-anon-key

# AI model providers, tried in this order. "ollama" runs a vision model locally (no API key):
#   install Ollama, then: ollama pull qwen2.5vl:7b
# Only providers listed here are used. Groq and Gemini (cloud) are off unless added,
# e.g. LLM_PROVIDERS=ollama,groq,gemini. Without any provider, local OCR is used.
LLM_PROVIDERS=ollama
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_VISION_MODEL=qwen2.5vl:7b
# OLLAMA_TEXT_MODEL=qwen2.5vl:7b
# OLLAMA_TIMEOUT=300
# OLLAMA_NUM_CTX=8192
GROQ_API_KEY=your-groq-api-key
GEMINI_API_KEY=your-gemini-api-key

# Optional model overrides (defaults shown)
# GROQ_VISION_MODEL=qwen/qwen3.8-27b
# GROQ_TEXT_MODEL=openai/gpt-oss-120b
# GEMINI_MODEL=gemini-3.5-flash-lite
# GEMINI_TEXT_MODEL=gemini-flash-lite-latest
